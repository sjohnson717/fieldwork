{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "access_code": {
      "type": "string"
    },
    "buyer_token": {
      "type": "string"
    },
    "team_token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft"
    },
    "closed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Set when status moves to closed. Lets the results tab spot responses revised after the engagement was reported on \u2014 personal assessments stay editable after close, so the aggregate can move under a delivered report."
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "team_gap",
        "personal"
      ],
      "default": "team_gap",
      "description": "team_gap: importance/execution/ownership. personal: experience/skills/interest. Absent means team_gap."
    },
    "parent_assessment_id": {
      "type": "string",
      "description": "Personal assessments only, and optional. Links this personal assessment to a team gap assessment so the report can cross capability against the team's gaps."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free grouping \u2014 a client, a cohort, a support group. Flat and many-to-many on purpose; see this folder's README."
    },
    "collaborator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "org_id": {
      "type": "string",
      "description": "Organization this assessment belongs to. Absent/null means the legacy no-org bucket."
    }
  },
  "required": [
    "title",
    "access_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborator_ids": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "data.org_id": "{{user.data.org_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborator_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}