{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "access_code": {
      "type": "string"
    },
    "buyer_token": {
      "type": "string"
    },
    "team_token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "team_gap",
        "personal"
      ],
      "default": "team_gap",
      "description": "team_gap: importance/execution/ownership. personal: experience/skills/interest. Absent means team_gap."
    },
    "parent_assessment_id": {
      "type": "string",
      "description": "Personal assessments only, and optional. Links this personal assessment to a team gap assessment so the report can cross capability against the team's gaps."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "collaborator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "org_id": {
      "type": "string",
      "description": "Organization this assessment belongs to. Absent/null means the legacy no-org bucket."
    }
  },
  "required": [
    "title",
    "access_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborator_ids": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "data.org_id": "{{user.data.org_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.collaborator_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}