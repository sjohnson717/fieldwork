{
  "type": "object",
  "name": "User",
  "title": "User",
  "properties": {
    "email": {
      "type": "string",
      "description": "The email of the user"
    },
    "full_name": {
      "type": "string",
      "description": "The full name of the user"
    },
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "org_admin",
        "facilitator",
        "user"
      ]
    },
    "org_id": {
      "type": "string",
      "description": "Organization this user belongs to. Absent/null means the legacy no-org bucket.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "former_org_id": {
      "type": "string",
      "description": "The organization a revoked account used to belong to. Set by updateTeamMember when a revoke clears org_id, and cleared again the moment any role is granted back. Only meaningful while role is 'user'. It exists so the org admin who revoked someone can still see and delete that row afterwards — clearing org_id used to put it beyond their reach. Per-field rule as on org_id, and for the same reason: the entity-level update rule does not bind on User. See this folder's README.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "responses_seen_at": {
      "type": "object",
      "description": "When this user last looked at each assessment's results, as { since, assessments: { [assessmentId]: ISO date } }. Drives the unread-responses badges in /admin. 'since' is stamped the first time the badges load, so nothing reads as new on day one. Deliberately writable by the user themself and given no per-field rule: it only decides which badges they see, and grants nothing."
    },
    "pinned_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Assessments this user pinned to the top of the /admin sidebar, in the order they were pinned. Holding an id grants nothing: the sidebar only shows pins that resolve against assessments the user can already see. Self-writable with no per-field rule, like responses_seen_at, for the same reason."
    }
  },
  "required": [
    "full_name",
    "role",
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": null
  }
}