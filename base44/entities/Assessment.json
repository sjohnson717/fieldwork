{
  "name": "Assessment",
  "properties": {
    "title": { "type": "string" },
    "tagline": { "type": "string" },
    "company_name": { "type": "string" },
    "access_code": { "type": "string" },
    "buyer_token": { "type": "string" },
    "team_token": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "closed"], "default": "draft" },
    "type": { "type": "string", "enum": ["team_gap", "personal"], "default": "team_gap" },
    "parent_assessment_id": { "type": "string" },
    "roles": { "type": "array", "items": { "type": "string" } },
    "activity_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "collaborator_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "org_id": { "type": "string" }
  },
  "required": ["title", "access_code"]
}
