{
  "name": "Response",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "respondent_id": {
      "type": "string"
    },
    "activity_id": {
      "type": "string"
    },
    "importance": {
      "type": "string",
      "enum": [
        "Not needed",
        "Nice to have",
        "Important",
        "Critical"
      ]
    },
    "execution": {
      "type": "string",
      "enum": [
        "Not done",
        "Inconsistent",
        "Good",
        "Excellent"
      ]
    },
    "suggested_owner": {
      "type": "string"
    },
    "experience": {
      "type": "string",
      "enum": [
        "None",
        "Limited",
        "Some",
        "Extensive"
      ],
      "description": "Personal assessments only. Scored 0/1/3/5 in src/lib/personal-scoring.js."
    },
    "skills": {
      "type": "string",
      "enum": [
        "None",
        "Basic",
        "Good",
        "Excellent"
      ],
      "description": "Personal assessments only. Scored 0/1/3/5 in src/lib/personal-scoring.js."
    },
    "interest": {
      "type": "string",
      "enum": [
        "None",
        "Limited",
        "Moderate",
        "Passionate"
      ],
      "description": "Personal assessments only. Scored 0/1/3/5 in src/lib/personal-scoring.js."
    }
  },
  "required": [
    "assessment_id",
    "respondent_id",
    "activity_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    }
  }
}