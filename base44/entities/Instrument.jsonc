{
  "name": "Instrument",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Stable slug the code may name: team_gap, personal, chaos, portfolio_health, idea_reality, product_success. Records are matched on this when the importer re-runs, so it must never change once an assessment references the instrument."
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "description": "One line under the name in the New Assessment panel."
    },
    "description": {
      "type": "string",
      "description": "What the person answering reads at the top of the survey: what they are about to be asked, in what spirit, and what they get back. Respondent voice. The facilitator's version of the same thing is `summary`."
    },
    "summary": {
      "type": "string",
      "description": "What this instrument is for and what it produces, written for the facilitator choosing between seven of them in the New Assessment panel. This is the whole point of the panel; a name alone does not say when to reach for Portfolio Health over Chaos. Kept apart from `description` because the survey intro speaks to the person answering and this speaks to the person who bought it, and copy written for one reads wrong to the other."
    },
    "question_source": {
      "type": "string",
      "enum": [
        "library",
        "instrument"
      ],
      "default": "instrument",
      "description": "library: draws from the shared Activity library, and the assessment picks a subset. instrument: asks its own fixed question list, every question every time."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered section names, one survey page each. For library instruments these are the facets; for the rest they are the categories the questions carry."
    },
    "scale_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "The axes asked about every question, in the order they are asked. One for the four imported instruments, two or three for team gap and personal."
    },
    "ask_ownership": {
      "type": "boolean",
      "default": false,
      "description": "Team gap only: the third question, which is a choice among the assessment's roles rather than a rating and is scored by nothing."
    },
    "report_style": {
      "type": "string",
      "enum": [
        "gap",
        "profile",
        "distribution",
        "dimension"
      ],
      "default": "distribution",
      "description": "Which report this instrument produces. A facet wheel over importance-against-execution, a personal capability profile, a per-question distribution, and a five-dimension practice profile are four different arguments, so they stay four renderers behind one route. dimension is read on the respondent's own summary; on the admin side it is reported as a distribution like any other fixed-question instrument."
    },
    "band_basis": {
      "type": "string",
      "enum": [
        "points",
        "mean"
      ],
      "default": "points",
      "description": "What a band's min_score and max_score are measured in. points: the total earned across the survey, which is how the four imported instruments have always banded. mean: the average points per answered question, which is what an instrument reporting on a 0-3 scale needs -- and it is also the honest one, because a total measures a skipped question as a low answer and an average leaves it out."
    },
    "subject_label": {
      "type": "string",
      "description": "Set when the instrument is about one named thing rather than the team: 'Which product are you assessing?'. Everyone answering must be scoring the same subject, so it is a field on the assessment rather than a question anybody can skip."
    },
    "sort_order": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "internal": {
      "type": "boolean",
      "default": false,
      "description": "Ours to run, never offered to a customer organization: it is filtered out of the New Assessment panel for anyone but a super-admin. A presentation rule and not a secret -- instrument content reads open so the unauthenticated survey can render it, so anything here is readable by anyone who asks the API for it."
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
