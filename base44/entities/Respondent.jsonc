{
  "name": "Respondent",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed"
      ],
      "default": "started"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "Where this person came from, captured when they arrived on the code link: utm_source, else the referring site's host. Same meaning as Arrival.source, so starts and completions line up against arrivals."
    },
    "medium": {
      "type": "string",
      "description": "The arriving link's utm_medium. See Arrival.medium."
    },
    "campaign": {
      "type": "string",
      "description": "The arriving link's utm_campaign. See Arrival.campaign."
    },
    "activity_log": {
      "type": "string"
    },
    "closing_comments": {
      "type": "string",
      "description": "Free text: \"What else do you want to tell us?\" Admin-only; never reported."
    },
    "missing_coverage": {
      "type": "string",
      "description": "Free text: anything they do in their role the survey did not ask about. Candidate activities for the library. Admin-only; never reported."
    }
  },
  "required": [
    "assessment_id",
    "name",
    "token"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "org_admin" } },
        { "user_condition": { "role": "facilitator" } }
      ]
    }
  }
}