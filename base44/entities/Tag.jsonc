{
  "name": "Tag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "org_id": {
      "type": "string",
      "description": "Consulting organization this tag belongs to. Absent/null is the legacy no-org bucket."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "data.org_id": "{{user.data.org_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_admin"
              }
            },
            {
              "data.org_id": "{{user.data.org_id}}"
            }
          ]
        }
      ]
    }
  }
}