{
  "name": "Activity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "facet": {
      "type": "string",
      "enum": [
        "LEARN",
        "DEFINE",
        "COMMIT",
        "DESCRIBE",
        "CREATE",
        "PREPARE",
        "DELIVER"
      ]
    },
    "preferred_owner": {
      "type": "string"
    },
    "try_this": {
      "type": "string",
      "description": "One concrete thing a person could do this week to build this activity. Sits on the activity rather than on a Resource because it is advice, not a link, and every activity has exactly one."
    },
    "sort_order": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "assessment_id": {
      "type": "string"
    },
    "org_id": {
      "type": "string",
      "description": "Custom activities only: the organization whose assessment this belongs to, stamped from the assessment at create. Library activities carry none deliberately — they are shared authored content, and an absent org_id is what confines them to super-admin and their own creator. See this folder's README."
    }
  },
  "required": [
    "name",
    "facet"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "org_admin" } },
        { "user_condition": { "role": "facilitator" } }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "created_by_id": "{{user.id}}" },
        {
          "$and": [
            { "user_condition": { "role": "org_admin" } },
            { "data.org_id": "{{user.data.org_id}}" }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "created_by_id": "{{user.id}}" },
        {
          "$and": [
            { "user_condition": { "role": "org_admin" } },
            { "data.org_id": "{{user.data.org_id}}" }
          ]
        }
      ]
    }
  }
}