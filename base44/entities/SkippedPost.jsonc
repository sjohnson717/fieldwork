{
  "name": "SkippedPost",
  "type": "object",
  "properties": {
    "content_key": {
      "type": "string",
      "description": "The id this post has in content/skipped-posts.md, which is the article's slug. A skip is a judgement somebody made about one post; the file is where the list survives, and the id is what keeps a re-titled post from reading as a new one."
    },
    "url": {
      "type": "string",
      "description": "The blog post's address, as the feed gives it. A post in the feed whose address is here is not offered again under New from the blog."
    },
    "title": {
      "type": "string",
      "description": "The post's title when it was skipped, so the skipped list reads as posts rather than addresses."
    }
  },
  "required": [
    "url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        },
        {
          "user_condition": {
            "role": "facilitator"
          }
        }
      ]
    }
  }
}
