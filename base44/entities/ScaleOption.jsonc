{
  "name": "ScaleOption",
  "type": "object",
  "properties": {
    "scale_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "What the respondent sees and what is stored on the Response. Labels are stored rather than points so re-scoring an axis never requires touching answered data, which is how the personal axes already work."
    },
    "points": {
      "type": "number",
      "description": "Display and scoring value. Deliberately allowed to be non-linear: 1/3/5/8 on the challenge scale, because evenly spaced options give self-raters a comfortable middle to park in."
    },
    "sort_order": {
      "type": "number",
      "description": "Presentation order, worst to best. The colour ramp is keyed off position, so a new scale needs no new colour map."
    }
  },
  "required": [
    "scale_id",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
